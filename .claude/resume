#!/bin/bash
#
# Projector Session Resume Script
# Run this to check current session state and get resume prompts
#

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
SESSION_FILE="$SCRIPT_DIR/SESSION_STATE.md"

# Colors
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo ""
echo -e "${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║              PROJECTOR SESSION STATE                         ║${NC}"
echo -e "${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""

if [[ ! -f "$SESSION_FILE" ]]; then
    echo -e "${RED}ERROR: SESSION_STATE.md not found${NC}"
    echo "Expected at: $SESSION_FILE"
    exit 1
fi

# Extract key info from SESSION_STATE.md
LAST_UPDATED=$(grep "Last Updated" "$SESSION_FILE" | head -1 | sed 's/.*: //' | tr -d '>')
STATUS=$(grep "Status" "$SESSION_FILE" | head -1 | sed 's/.*: //' | tr -d '>')
BRANCH=$(grep "Branch" "$SESSION_FILE" | head -1 | sed 's/.*: //' | tr -d '>')

echo -e "${CYAN}Last Updated:${NC} $LAST_UPDATED"
echo -e "${CYAN}Status:${NC}       $STATUS"
echo -e "${CYAN}Branch:${NC}       $BRANCH"
echo ""

# Show current task section
echo -e "${YELLOW}── Current Task ──${NC}"
sed -n '/^## Current Task/,/^---/p' "$SESSION_FILE" | grep -v "^##" | grep -v "^---" | head -5
echo ""

# Show uncommitted files
echo -e "${YELLOW}── Uncommitted Changes ──${NC}"
cd "$PROJECT_DIR"
git status --short 2>/dev/null || echo "(not a git repo)"
echo ""

# Show resume prompt
echo -e "${GREEN}── Resume Prompt (copy into Claude Code) ──${NC}"
echo ""
echo "Resume from .claude/SESSION_STATE.md - read it, summarize status, continue work."
echo ""

# Show quick commands
echo -e "${CYAN}── Quick Commands ──${NC}"
echo "  cat .claude/SESSION_STATE.md    # Full session state"
echo "  cat PROJECT_ROADMAP.md          # Project progress"
echo "  cat FEATURES.md                 # Feature registry"
echo ""
